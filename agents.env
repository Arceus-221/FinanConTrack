
# paste exact IDs, e.g. google/<model-id>. Free-tier quotas are PER MODEL, so using three
# different models gives you three separate daily budgets.
MODEL_STRONG= google/gemini-3.8-flash  # reviewer (also pick this for the planner in the TUI) - most capable, scarcest quota
MODEL_FAST=   google/gemini-3.6-flash  # implementer - a Flash-class model
MODEL_LITE=   google/gemini-3.1-flash-lite  # tester - a Flash-Lite-class model (highest free limits); empty = reuse MODEL_FAST

# Loop tuning (defaults shown)
# MAX_ROUNDS=4        implement/test/review cycles per task before it is marked blocked
# MAX_RETRIES=4       retries per call on API errors / 429
# BACKOFF_BASE=60     seconds, doubles every retry
# CALL_GAP=10         pause between calls
# CONTINUE_ON_BLOCK=1 skip a blocked task and continue (0 = stop the loop)
